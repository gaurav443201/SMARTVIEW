# ─── SmartView AWS DynamoDB Configuration ─────────────────────────────────────
VITE_AWS_DYNAMODB_TABLE_ARN=arn:aws:dynamodb:us-east-1:842544789430:table/SmartView_Core
VITE_AWS_REGION=us-east-1
VITE_DYNAMODB_TABLE_NAME=SmartView_Core

# AWS IAM User Credentials (Access Key & Secret Key)
# Required by AWS to authenticate and perform PutItem/GetItem calls to the DynamoDB table:
VITE_AWS_ACCESS_KEY_ID=
VITE_AWS_SECRET_ACCESS_KEY=

# ─── OpenAI API Configuration ──────────────────────────────────────────────────
VITE_OPENAI_API_KEY=your_openai_api_key_here
